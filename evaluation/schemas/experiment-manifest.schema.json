{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bfl.example/schemas/rag/experiment-manifest.schema.json",
  "title": "Protected RAG Experiment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experimentId",
    "datasetHash",
    "datasetComponents",
    "sourceId",
    "runId",
    "codeCommit",
    "sourceTreeHash",
    "submittedContextHash",
    "imageDigest",
    "baseImageDigest",
    "dependencyLockHash",
    "acrBuildId",
    "catalogSha",
    "catalogEtag",
    "profiles",
    "modelDeployments",
    "environment",
    "evaluatorVersions",
    "pythonVersion",
    "principalCase",
    "retrievalMode",
    "k",
    "repeatIndex",
    "seed",
    "evaluationAsOf",
    "candidateSetHash",
    "baselineRankingHash",
    "candidateRankingHash",
    "startedAt"
  ],
  "properties": {
    "experimentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "datasetHash": { "$ref": "#/$defs/sha256" },
    "datasetComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groundTruthHash",
        "principalCasesHash",
        "approvalHash",
        "datasetManifestHash"
      ],
      "properties": {
        "groundTruthHash": { "$ref": "#/$defs/sha256" },
        "principalCasesHash": { "$ref": "#/$defs/sha256" },
        "approvalHash": { "$ref": "#/$defs/sha256" },
        "datasetManifestHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "codeCommit": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceTreeHash": { "$ref": "#/$defs/sha256" },
    "submittedContextHash": { "$ref": "#/$defs/sha256" },
    "imageDigest": { "$ref": "#/$defs/imageDigest" },
    "baseImageDigest": { "$ref": "#/$defs/imageDigest" },
    "dependencyLockHash": { "$ref": "#/$defs/sha256" },
    "acrBuildId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "catalogSha": { "$ref": "#/$defs/sha256" },
    "catalogEtag": { "type": "string", "pattern": "\\S" },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extraction",
        "chunking",
        "cleaning",
        "enrichment",
        "embedding",
        "retrieval",
        "prompt"
      ],
      "properties": {
        "extraction": { "$ref": "#/$defs/profile" },
        "chunking": { "$ref": "#/$defs/profile" },
        "cleaning": { "$ref": "#/$defs/profile" },
        "enrichment": { "$ref": "#/$defs/profile" },
        "embedding": { "$ref": "#/$defs/profile" },
        "retrieval": { "$ref": "#/$defs/profile" },
        "prompt": { "$ref": "#/$defs/profile" }
      }
    },
    "modelDeployments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embedding", "chat", "evaluator"],
      "properties": {
        "embedding": { "type": "string", "minLength": 1, "maxLength": 200 },
        "chat": { "type": "string", "minLength": 1, "maxLength": 200 },
        "evaluator": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "environment": { "enum": ["local", "dev", "evaluation"] },
    "evaluatorVersions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "pythonVersion": {
      "type": "string",
      "pattern": "^3\\.(1[0-9]|[2-9][0-9])\\.[0-9]+$"
    },
    "principalCase": { "type": "string", "minLength": 1, "maxLength": 200 },
    "retrievalMode": { "enum": ["hybrid", "vector", "full_text"] },
    "k": { "type": "integer", "minimum": 1, "maximum": 100 },
    "repeatIndex": { "type": "integer", "minimum": 1 },
    "seed": { "type": ["integer", "null"] },
    "evaluationAsOf": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "candidateSetHash": { "$ref": "#/$defs/sha256" },
    "baselineRankingHash": { "$ref": "#/$defs/sha256" },
    "candidateRankingHash": { "$ref": "#/$defs/sha256" },
    "startedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "parameters"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "parameters": { "type": "object" }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
