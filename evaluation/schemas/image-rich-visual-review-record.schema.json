{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bfl.example/schemas/rag/image-rich-visual-review-record.schema.json",
  "title": "Protected Image-Rich PoC Visual Review Record",
  "description": "SME verdict for one candidate-arm visual hit. No image bytes or source text. Notes must be short and safe.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "queryId",
    "arm",
    "documentId",
    "locatorKind",
    "locatorLabel",
    "locatorOrdinalStart",
    "locatorOrdinalEnd",
    "factualSupport",
    "provenance",
    "criticalInvention",
    "reviewerIdentity",
    "reviewedAt"
  ],
  "properties": {
    "queryId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "arm": {
      "enum": ["di-figures-vision", "cu-document-search"]
    },
    "documentId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "locatorKind": {
      "enum": ["page", "section", "slide", "worksheet"]
    },
    "locatorLabel": { "type": "string", "minLength": 1, "maxLength": 200 },
    "locatorOrdinalStart": { "type": "integer", "minimum": 1 },
    "locatorOrdinalEnd": { "type": "integer", "minimum": 1 },
    "factualSupport": {
      "enum": ["supported", "partial", "unsupported"]
    },
    "provenance": { "enum": ["correct", "incorrect"] },
    "criticalInvention": { "type": "boolean" },
    "reviewerIdentity": { "type": "string", "minLength": 1, "maxLength": 200 },
    "reviewedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "notes": { "type": "string", "maxLength": 2000 }
  }
}
